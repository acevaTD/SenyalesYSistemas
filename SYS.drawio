  <diagram name="P1" id="wmgkhAhmjzbNm2a3-ZR-">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="1" shadow="0">
      <root>
        <mxCell id="wZk-9KWJGG2PSf4jxB5Z-0" />
        <mxCell id="wZk-9KWJGG2PSf4jxB5Z-1" parent="wZk-9KWJGG2PSf4jxB5Z-0" />
        <mxCell id="wZk-9KWJGG2PSf4jxB5Z-2" parent="wZk-9KWJGG2PSf4jxB5Z-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=2;backgroundOutline=0;shadow=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1110" width="770" x="30" y="30" as="geometry" />
        </mxCell>
        <mxCell id="KsFgZ2X-q64hU2eYxf-S-0" parent="wZk-9KWJGG2PSf4jxB5Z-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;backgroundOutline=0;shadow=0;" value="&lt;b&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 24px;&quot;&gt;Introducción&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="140" x="345" y="30" as="geometry" />
        </mxCell>
        <mxCell id="0HzRcHgk6JjbH9_UHfAB-1" parent="wZk-9KWJGG2PSf4jxB5Z-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;Determina la energía y la potencia de las siguientes señales:&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;ul&gt;&lt;li&gt;Escalón unitario discreto \(x(n) = u(n)\):&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;Energía:&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;\(E = \sum_{n=-\infty}^{\infty}\left| x(n) \right|²\space=\space\sum_{n=0}^{\infty}1²\space=\space\infty\)&lt;br&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;Potencia:&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;\(P = \lim_{N \to \infty} \frac{1}{2N+1}\sum_{n=-N}^{N}\left| x(n) \right|²\space=\space \lim_{N \to \infty} \frac{1}{2N+1}\sum_{n=-N}^{N}\left| u(n) \right|²\)&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;Como \(u(n)=1\) si \(n \ge 0\):&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;\(\lim_{N \to \infty} \frac{1}{2N+1}\sum_{n=-N}^{N}\left| u(n) \right|²\space=\space\lim_{N \to \infty} \frac{1}{2N+1}\sum_{n=0}^{N}\left| 1 \right|²\space=\space\lim_{N \to \infty} \frac{N+1}{2N+1}=\color{DarkBlue} \frac{1}{2}\)&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;ul&gt;&lt;li&gt;\(x(n)=10e^{⁻\pi jn}·u(n)\):&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;Energía:&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;\(E = \sum_{n=-\infty}^{\infty} \left| 10e^{-\pi jn}u(n)\right|\space=\space\sum_{n=0}^{\infty}10²·1²\space=\space\color{DarkBlue} \infty\)&amp;nbsp; (ya que&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;\(u(n)=1\) si \(n \ge 0\))&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Potencia:&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;\(P = lim_{N \to \infty} \frac{1}{2N+1}\sum_{n=-N}^{N}\left| 10e^{-\pi jn}u(n) \right|²\space=\space\lim_{N \to \infty} \frac{1}{2N+1}\sum_{n=0}^{N}10²\space=\space\lim_{N \to \infty} \frac{100N}{2N+1}\space=\space \color{DarkBlue}50\)&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;ul&gt;&lt;li&gt;\(x(n) = u(n)-u(n-10):\)&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;Energía:&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;\(E = \sum_{n=-\infty}^{\infty}\left| x(n) \right|²\space=\space\sum_{n=-\infty}^{\infty}\left| u(n)-u(n-10) \right|²\space=\space\sum_{n=0}^{\infty}\left| 1-u(n-10) \right|²\space=\space\sum_{n=0}^{9}\left| 1-0 \right|²\space=\space\ \)&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;br&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;\(=\sum_{n=10}^{\infty}\left| 1-1 \right|²\space=\space\color{DarkBlue} 10\)&lt;ul&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;Potencia: \(P=0\), ya que la señal es finita.&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;br&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;\(x(n) = u(-n)\):&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;Energía:&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;\(E = \sum_{n=-\infty}^{\infty}\left| x(n) \right|²\space=\space\sum_{n=-\infty}^{0}1²\space=\space\infty\)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;Potencia:&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;\(P = \lim_{N \to \infty} \frac{1}{2N+1}\sum_{n=-N}^{N}\left| x(n) \right|²\space=\space \lim_{N \to \infty} \frac{1}{2N+1}\sum_{n=-N}^{N}\left| u(-n) \right|² \)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Como \(u(-n)=1\) si \(n \le 0\):&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;\(\lim_{N \to \infty} \frac{1}{2N+1}\sum_{n=-N}^{N}\left| u(-n) \right|²\space=\space\lim_{N \to \infty} \frac{1}{2N+1}\sum_{n=-N}^{0}\left| 1 \right|²\space=\space\lim_{N \to \infty} \frac{N+1}{2N+1}=\color{DarkBlue} \frac{1}{2}\)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;\(x(n)=u²(n)\): Dado que \(u(n)\)&amp;nbsp;solo toma valores de 0 o 1, \(u²(n)=u(n)\). Los resultados son idénticos al primer ejercicio.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;Energía: \(\infty\)&lt;/li&gt;&lt;li&gt;Potencia: \(\color{DarkBlue} \frac{1}{2}\)&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;\(x(n) = \left\{ \begin{array}{cl}1-\left| n \right| &amp;amp; : \ -1\le n\le 1 \\0 &amp;amp; : \ \left| n\right|\gt 1\end{array} \right.\)&lt;/li&gt;&lt;/ul&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;Energía:&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;\(E = \sum_{n=-\infty}^{\infty}\left| x(n) \right|²\space=\space\sum_{n=-1}^{1}\left| 1-\left| n \right| \right|²+\sum_{n=2}^{\infty}0²\space=\space(1-1)²+(1-0)²+(1-1)²\space=\space\color{DarkBlue}1\)&lt;/div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;Potencia es 0, ya que la señal es finita.&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1010" width="730" x="50" y="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="P1 (II)" id="bcePzkXa7TRnvC2S4UD-">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="1" shadow="0">
      <root>
        <mxCell id="ZZ7Ei3ptJUl7aT9cW-zQ-0" />
        <mxCell id="ZZ7Ei3ptJUl7aT9cW-zQ-1" parent="ZZ7Ei3ptJUl7aT9cW-zQ-0" />
        <mxCell id="ZZ7Ei3ptJUl7aT9cW-zQ-2" parent="ZZ7Ei3ptJUl7aT9cW-zQ-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=2;backgroundOutline=0;shadow=0;movable=0;resizable=0;rotatable=0;deletable=0;editable=0;locked=1;connectable=0;" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1110" width="770" x="30" y="30" as="geometry" />
        </mxCell>
        <mxCell id="ZZ7Ei3ptJUl7aT9cW-zQ-3" parent="ZZ7Ei3ptJUl7aT9cW-zQ-1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;backgroundOutline=0;shadow=0;" value="&lt;b&gt;&lt;font face=&quot;Times New Roman&quot; style=&quot;font-size: 24px;&quot;&gt;Introducción&lt;/font&gt;&lt;/b&gt;" vertex="1">
          <mxGeometry height="40" width="140" x="345" y="30" as="geometry" />
        </mxCell>
        <mxCell id="ZZ7Ei3ptJUl7aT9cW-zQ-4" parent="ZZ7Ei3ptJUl7aT9cW-zQ-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;div style=&quot;text-align: justify;&quot;&gt;&lt;ul&gt;&lt;li&gt;&lt;span class=&quot;math-inline&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;\(x(n)=[10\cdot e^{-3jn}+5\cdot e^{-5jn}]\cdot u(n)\):&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;Energía:&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;\(u(n)=1\) si \((n \ge 0):\)&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;&amp;nbsp;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;\(\vert{}x(n)\vert{}^2 = (10e^{-3jn} + 5e^{-5jn})(10e^{3jn} + 5e^{5jn}) = 100 + 25 + 50e^{2jn} + 50e^{-2jn} = 125 + 100\cos(2n)\)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;math-inline&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;\(E = \sum_{n=0}^{\infty} (125 + 100\cos(2n)) = \color{DarkBlue}\infty\)&lt;/span&gt;&lt;span style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;math-inline&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;&lt;span class=&quot;math-inline&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Potencia:&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;&lt;span style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif; background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;\(P = \lim_{N \to \infty} \frac{1}{2N+1} \sum_{n=0}^{N} (125 + 100\cos(2n))\). Como \(cos(2n)\)&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;promedia a 0 en el infinito:&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;math-inline&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;\(P = \lim_{N \to \infty} \frac{125(N+1)}{2N+1} = \frac{125}{2} = \color{DarkBlue}62.5\)&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;math-inline&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span class=&quot;math-inline&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;span class=&quot;math-inline&quot; style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;\(x(n)=\frac{1}{2}\cdot[u(n-3)+u(-n)]\):&lt;/span&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;Energía:&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;\(E = \sum_{n=-\infty}^{\infty}\left| x(n) \right|²\space=\space\sum_{n=-\infty}^{0}\left| x(n) \right|²+\sum_{n=1}^{2}\left| x(n) \right|²+\sum_{n=3}^{\infty}\left| x(n) \right|²=\sum_{n=-\infty}^{0}\left| \frac{1}{2} \right|²+0+\sum_{n=3}^{\infty}\left| \frac{1}{2}² \right|=\color{DarkBlue} \infty\)&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;Potencia:&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;\(P = \lim_{N \to \infty} \frac{1}{2N+1}\sum_{n=-N}^{N}\left| x(n) \right|²\space=\space \lim_{N \to \infty} \frac{1}{2N+1}\bigg (\sum_{n=-N}^{0}\left| \frac{1}{2} \right|²+\sum_{n=3}^{\infty}\left| \frac{1}{2} \right|²\bigg )=\)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;\(\lim_{N \to \infty} \frac{1}{2N+1} \left( (N+1)\frac{1}{4} + (N-2)\frac{1}{4} \right) = \lim_{N \to \infty} \frac{(2N-1)/4}{2N+1} = \frac{1/2}{2} = \color {DarkBlue} \frac{1}{4}\)&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span class=&quot;math-inline&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;\(x(n)=\frac{1}{2}\cdot e^{\pi/3jn}\):&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;Energía:&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;&lt;span class=&quot;math-inline&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;\(E = \sum_{n=-\infty}^{\infty} \left(\frac{1}{2}\right)^2 = \color{DarkBlue}\infty\)&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;math-inline&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;&lt;span class=&quot;math-inline&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;Potencia:&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;\(P = \lim_{N \to \infty} \frac{1}{2N+1} \sum_{n=-N}^{N} \frac{1}{4} = \lim_{N \to \infty}\frac{1}{2N+1} · \frac{1}{4}(2N+1)=\color{DarkBlue} \frac{1}{4}\)&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;&lt;span class=&quot;math-inline&quot; style=&quot;line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;\(x(n)=(5+3j)u(n)\)&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;Energía:&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;El módulo al cuadrado es constante para \(n \ge 0: \vert{}x(n)\vert{}^2 = 5^2 + 3^2 = 25 + 9 = 34\). Por tanto:&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;math-inline&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;\(E = \sum_{n=0}^{\infty} 34 = \color{DarkBlue}\infty\)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span class=&quot;math-inline&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;ul&gt;&lt;li&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;Potencia:&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/ul&gt;&lt;div&gt;&lt;span class=&quot;math-inline&quot; style=&quot;font-family: &amp;quot;Google Sans Text&amp;quot;, sans-serif !important; line-height: 1.15 !important; margin-top: 0px !important; margin-left: 0px !important; margin-right: 0px !important;&quot;&gt;\(P = \lim_{N \to \infty} \frac{1}{2N+1} \sum_{n=0}^{N} 34 = \lim_{N \to \infty} \frac{34(N+1)}{2N+1} = 17\)&lt;/span&gt;&lt;font face=&quot;Google Sans Text, sans-serif&quot;&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="1010" width="730" x="50" y="-8" as="geometry" />
        </mxCell>
        <mxCell id="TY5SULgELKd8XAKHqy3U-0" parent="ZZ7Ei3ptJUl7aT9cW-zQ-1" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Basic-2519/circle-x-813.svg" value="" vertex="1">
          <mxGeometry height="24" width="24" x="190" y="240" as="geometry" />
        </mxCell>
        <mxCell id="bvzisipvOac89VDvbVKn-0" parent="ZZ7Ei3ptJUl7aT9cW-zQ-1" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Basic-2519/circle-x-813.svg" value="" vertex="1">
          <mxGeometry height="24" width="24" x="180" y="110" as="geometry" />
        </mxCell>
